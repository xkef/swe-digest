#!/usr/bin/env bash
#MISE description="Create the local environment from uv.lock, with the agent SDK and dev tools"
#MISE dir="{{config_root}}/agent"
set -euo pipefail

# --frozen installs uv.lock as committed. Without it, uv re-resolves and can
# write machine-local settings into the lock. `mise run deps:lock` updates it.
uv sync --frozen --extra agent
