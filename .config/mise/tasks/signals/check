#!/usr/bin/env bash
#MISE description="Type-check the signals Worker and run its tests in workerd"
#MISE dir="{{config_root}}/signals"
set -euo pipefail

# The types come from the installed workerd, so they are generated here rather
# than committed. A committed copy would go stale with every wrangler bump.
npx wrangler types --strict-vars=false
npx tsc --noEmit
npx vitest run "$@"
