# Build output
/dist/
/site/public/

# Generated by `mise run site:build` from data/digests/. The section index
# site/content/digests/_index.md is hand-written and stays tracked.
/site/data/
/site/content/stories/
/site/content/digests/*/

# Private and local-only
.claude/
/.claude-notes/
/.idea/
.DS_Store
*.tmp

# The agent's empty working directory, and the run's exported files
/.run/

# Tool caches. Unanchored on purpose: a command run from a subdirectory writes
# them there rather than at the root.
__pycache__/
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.rumdl_cache/

# Vale styles, downloaded by `vale sync`. The project vocabulary is tracked.
/.config/vale/*
!/.config/vale/config/
/.config/vale/config/*
!/.config/vale/config/vocabularies/
