# Build output
/dist/
/public/
/.zola-cache/

# Derived by `make stories`, rebuilt on every build. The day pages are copied
# from data/digests/; site/content/digests/_index.md is the authored section
# index and stays tracked.
/site/data/
/site/content/stories/
/site/content/home/
/site/content/digests/*/

# Private and local-only
PRIVATE_CONTEXT.md
.claude/
/.claude-notes/
/.idea/
.DS_Store
*.tmp

# Collection scratch, and the unattended run's exported artifact
/.cache/
/.run/

# Tool caches. Unanchored on purpose: a command run from a subdirectory writes
# them there rather than at the root.
__pycache__/
.venv/
.coverage
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.rumdl_cache/
