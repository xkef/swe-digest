// The signals Worker. Workers Builds deploys it from main with
// `npm run deploy`, root directory signals/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swe-digest-signals",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // Workers Logs keeps every invocation and console.log line for 3 days on
  // the Free plan. The dashboard and `wrangler tail` read them.
  "observability": { "enabled": true },

  "durable_objects": {
    "bindings": [{ "name": "SIGNALS", "class_name": "SignalStore" }],
  },
  // Each entry runs once per deployment, in order. Never edit one that has
  // shipped. v2 renames the class in place, so its stored data stays.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ReaderAgent"] },
    {
      "tag": "v2",
      "renamed_classes": [{ "from": "ReaderAgent", "to": "SignalStore" }],
    },
  ],

  // Every request counts against its address before it can reach the store.
  // Readers send a few requests per page, and runs two per run. The ID only
  // needs to be unique within the account.
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],

  // The vars that differ per deployment come from config.yaml at the
  // repository root. scripts/wrangler.mjs passes them on every deploy.

  // The owner's Access email. A secret only to keep it out of the repository.
  // Every other enrolled email is a friend.
  "secrets": { "required": ["OWNER_EMAIL"] },
}
