#!/usr/bin/env bash
#MISE description="Serve the site at 127.0.0.1:3000"
#MISE dir="{{config_root}}"
set -euo pipefail

# The footer links the build time to the commit the site was built from.
export RELEASE="${RELEASE:-$(git rev-parse --short HEAD 2>/dev/null || echo dev)}"
export BUILD_DATE="${BUILD_DATE:-$(date -u +%Y-%m-%dT%H:%MZ)}"

uv run --no-sync python -m digest build
RUST_LOG="${RUST_LOG:-info}" zola --root site serve --interface 127.0.0.1 --port 3000
