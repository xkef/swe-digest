#!/usr/bin/env bash
#MISE description="Lint the hand-written Markdown with Vale: Google style and ai-tells"
#MISE dir="{{config_root}}"
set -euo pipefail

# --no-global keeps a personal Vale config from changing the project's rules.
vale --no-global --config .mise/vale.ini sync >/dev/null
vale --no-global --config .mise/vale.ini README.md AGENTS.md .github/SECURITY.md \
  agent/prompts
